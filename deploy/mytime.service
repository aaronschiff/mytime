[Unit]
Description=mytime time tracking & billing
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/mytime
Environment=MYTIME_DB_URL=sqlite:////opt/mytime/mytime.db
ExecStart=/usr/local/bin/uv run uvicorn mytime.main:app --host 0.0.0.0 --port 8000
Restart=on-failure
User=mytime

[Install]
WantedBy=multi-user.target
