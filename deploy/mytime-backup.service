[Unit]
Description=mytime database backup
After=local-fs.target

[Service]
Type=oneshot
User=mytime
Environment=MYTIME_DB_PATH=/opt/mytime/mytime.db
Environment=MYTIME_BACKUP_DIR=/var/backups/mytime
ExecStart=/usr/local/bin/uv run python /opt/mytime/deploy/backup.py
StandardOutput=journal
StandardError=journal
